{
  "name": "pillars-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"vite\"",
    "server": "node server.js",
    "build": "vite build",
    "check:refunds": "node scripts/check_refunds.js",
    "sync": "git add -A && git commit -m \"chore: sync from dev container\" || echo \"No changes to commit\" && git push -u origin main",
    "sync:watch": "node scripts/auto_sync.js",
    "live": "node run-live.mjs",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "test": "vitest",
    "check:vscode-tasks": "node ./tools/check_tasks_presentation.js",
    "apply:vscode-no-terminal": "node ./tools/apply_vscode_global_no_terminal.js",
    "preview": "vite preview",
    "build:ico": "node ./tools/build-ico.js"
  },
  "dependencies": {
    "@babel/parser": "^7.22.11",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.3.1",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@vitejs/plugin-react": "^4.2.1",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@babel/parser": "^7.22.11",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.3.1",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "chokidar": "^3.6.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "jsdom": "^22.1.0",
    "playwright": "^1.57.0",
    "postcss": "^8.4.35",
    "svg-to-ico": "^1.0.17",
    "tailwind-scrollbar": "^3.1.0",
    "tailwindcss": "^3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "vite": "^5.1.6",
    "vitest": "^1.6.1"
  }
}
